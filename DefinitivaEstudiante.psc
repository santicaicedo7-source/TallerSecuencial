Algoritmo NotaDefinitiva
	Definir Nota1, Nota2, Nota3, Nota4,NotaDf Como Real
	Escribir "Escribir la Nota 1" 
	Leer Nota1
	Escribir "Escribir la Nota 2"
	Leer Nota2
	Escribir "Escribir la Nota 3"
	Leer Nota3
	Escribir "Escribir la Nota4"
	Leer Nota4
	NotaDf = (Nota1 + Nota2 + Nota3 + Nota4) /4
	Escribir "La definitiva es: ", NotaDf
	
FinAlgoritmo
