Algoritmo UsoFunciones
	Definir num, seno, coseno, tangente, raizCudrada, logaritmoNatural, logaritmo10 Como Real 
	Escribir "Ingrese el numero: "
	Leer num 
	seno = sen(num)
	coseno = cos(num)
	tangente = tan(num)
	raizCuadrada = raiz(num)
	logaritmoNatural = ln(num)
	logaritmo10 = ln(num)/ln(10)
	
	Escribir "Los valores del numero ", num " son: "
	Escribir "Su Seno es: " seno
	Escribir "Su coseno es: " coseno
    Escribir "Su Tangente es: " tangente
	Escribir "Su Raiz Cuadrada es: " raizCuadrada
	Escribir "Su logaritmo natural es: " logaritmoNatural
	Escribir "Su logaritmo en base 10 es: " logaritmo10
	
	
FinAlgoritmo
